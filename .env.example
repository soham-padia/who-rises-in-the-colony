# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Load it before running anything:  set -a && source .env && set +a

# Adaption (hackathon credits; the default backend)
ADAPTION_API_KEY=
MODEL=gemma-4-31b-it

# Any OpenAI-compatible provider (use with --backend openai)
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# Hugging Face, for uploading or downloading the full transcripts
# Write token from https://huggingface.co/settings/tokens (read-only is enough to download)
HF_TOKEN=
HF_DATASET=sohampadianeu/who-rises-in-the-colony-runs
